{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // --- Oppgave 10: autentisering mot Microsoft Entra ID ----------------------
  // AV som standard. Er den PÅ, kan ikke frontenden i samling 4 snakke med API-et
  // uten et gyldig token, og bonussteget der brekker. Se FASIT.md, oppgave 10.
  //
  // Ingen ekte tenant-id-er eller client-id-er i repoet — dette er plassholdere.
  "Kaffebar": {
    "Auth": {
      "Enabled": false,
      // "EntraId" = ekte tenant, "LocalJwt" = lokale testtokens fra `dotnet user-jwts`.
      "Mode": "EntraId",
      "RequireBaristaRole": false
    },
    // --- Valgfritt siste steg: hendelser til RabbitMQ. Også AV som standard. ---
    "Events": {
      "Enabled": false,
      "Exchange": "kaffebar",
      "Uri": "amqp://guest:guest@localhost:5672"
    },
    "Barista": {
      "AutoEnabled": false,
      "IntervalMs": 8000
    }
  },

  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<din-tenant-id>",
    "ClientId": "<din-client-id>",
    "Audience": "api://<din-client-id>"
  }
}
